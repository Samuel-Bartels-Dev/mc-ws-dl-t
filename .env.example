# Optional local overrides for development scripts.
# Copy to .env and edit values for your machine.

# Smoke test HTTP user agent override (optional).
MC_WS_DL_T_SMOKE_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36

# Smoke test request timeout override in seconds (optional).
MC_WS_DL_T_SMOKE_TIMEOUT=20

